# ─── Mercado Pago ─────────────────────────────────────────────────────────────
# Obtén tus credenciales en: https://www.mercadopago.com.co/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token-here

# ─── Site URL ─────────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra final) — usada para back_urls y webhooks MP
NEXT_PUBLIC_SITE_URL=https://pulseai.co

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obtén estos valores en: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Auth (opcional) ──────────────────────────────────────────────────────────
# Para Google OAuth real: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (opcional) ─────────────────────────────────────────────────────────
# Para envío de facturas y confirmaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=centrodigital2023@gmail.com
SMTP_PASS=your-app-password
